generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExampleRecord {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

model CrewProfileImageCache {
  notionPageId   String   @id
  imageUrl       String?
  sourceImageUrl String?
  localPath      String?
  contentType    String?
  contentHash    String?
  fileSize       Int?
  lastSyncedAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TeamActivityMetadata {
  id          Int      @id @default(autoincrement())
  notionPageId String  @unique
  sourceType  String
  koName      String
  enName      String?
  briefName   String?
  description String?  @db.Text
  isVisible   Boolean  @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExampleRecord {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

model CrewProfileImageCache {
  notionPageId   String   @id
  imageUrl       String?
  sourceImageUrl String?
  localPath      String?
  contentType    String?
  contentHash    String?
  fileSize       Int?
  lastSyncedAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CrewImageRefreshJob {
  id String @id @default(uuid())
  status String @default("RUNNING")
  activeKey String? @unique
  owner String
  requestedBy String
  leaseUntil DateTime
  createdAt DateTime @default(now())
  finishedAt DateTime?
  items CrewImageRefreshItem[]
  @@index([createdAt])
}

model CrewImageRefreshItem {
  id String @id @default(uuid())
  jobId String
  crewId String
  crewName String
  notionPageId String?
  status String @default("PENDING")
  message String?
  finishedAt DateTime?
  job CrewImageRefreshJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, crewId])
}

model TeamActivityMetadata {
  id           Int       @id @default(autoincrement())
  notionPageId String    @unique
  sourceType   String
  koName       String
  enName       String?
  briefName    String?
  description  String?   @db.Text
  isVisible    Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CrewSource {
  id                  String   @id @default(uuid())
  sourceKey           String   @unique
  primaryNotionPageId String?  @unique
  profileAccountIds   Json?
  name                String
  email               String?
  profileImageUrl     String?
  profileImageCacheUrl String?
  notionDescription   String?  @db.Text
  joinedGen           Int?
  univDepartment      String?
  univJoinedYear      String?
  sourcePayload       Json?
  sourceArchived      Boolean  @default(false)
  lastSyncedAt        DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  adminProfile         CrewAdminProfile?
  termTeamSources      CrewTermTeamSource[]
  termTeamOverrides    CrewTermTeamOverride[]
  projectVisibilities  CrewProjectVisibility[]
  blogVisibilities     CrewBlogVisibility[]
  participantOverrides ProjectParticipantOverride[]
}

model CrewAdminProfile {
  id           String   @id @default(uuid())
  crewSourceId String   @unique
  isVisible    Boolean  @default(false)
  description  String?  @db.Text
  univDepartmentOverride String?
  univJoinedYearOverride String?
  nameOverride String?
  emailOverride String?
  joinedGenOverride Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  crewSource CrewSource @relation(fields: [crewSourceId], references: [id], onDelete: Cascade)
}

model CrewTermTeamSource {
  id                String   @id @default(uuid())
  crewSourceId      String
  notionPageId      String   @unique
  generation        Int
  activityTerm      String
  teamName          String?
  profileAccountIds Json?
  sourcePayload     Json?
  sourceArchived    Boolean  @default(false)
  lastSyncedAt      DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  crewSource CrewSource @relation(fields: [crewSourceId], references: [id], onDelete: Cascade)

  @@unique([crewSourceId, generation])
  @@index([activityTerm])
}

model CrewTermTeamOverride {
  id                  String    @id @default(uuid())
  crewSourceId        String
  generation          Int
  activityTerm        String
  teamName            String
  notionSyncedAt      DateTime?
  notionWriteFailedAt DateTime?
  notionWriteError    String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  crewSource CrewSource @relation(fields: [crewSourceId], references: [id], onDelete: Cascade)

  @@unique([crewSourceId, generation])
  @@index([activityTerm])
}

model ProjectSource {
  id                 String   @id @default(uuid())
  notionPageId       String   @unique
  titleKo            String
  titleEn            String?
  titleBrief         String?
  status             String?
  startedAt          String?
  endedAt            String?
  backgroundImageUrl String?
  backgroundColor    String?
  participantRefs    Json?
  sourcePayload      Json?
  sourceArchived     Boolean  @default(false)
  lastSyncedAt       DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adminProfile         ProjectAdminProfile?
  cloudProducts        CloudProduct[]
  crewVisibilities     CrewProjectVisibility[]
  featuredBlogs        ProjectFeaturedBlog[]
  periodOverrides      ProjectPeriodOverride[]
  participantOverrides ProjectParticipantOverride[]
}

model ProjectAdminProfile {
  id                 String   @id @default(uuid())
  projectSourceId    String   @unique
  isVisible          Boolean  @default(false)
  titleKoOverride    String?
  titleEnOverride    String?
  titleBriefOverride String?
  description        String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projectSource ProjectSource @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
}

model BlogPostSource {
  id              String    @id @default(uuid())
  notionPageId    String    @unique
  title           String
  url             String?
  projectName     String?
  contentPreview  String?   @db.Text
  recordedAt      DateTime?
  participantRefs Json?
  projectRefs     Json?
  sourcePayload   Json?
  sourceArchived  Boolean   @default(false)
  lastSyncedAt    DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  crewVisibilities   CrewBlogVisibility[]
  featuredInProjects ProjectFeaturedBlog[]
  draftJobs          AdminBlogDraftJob[]
}

model AdminSetting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminBlogDraftJob {
  id               String    @id @default(uuid())
  blogPostSourceId String
  status           String
  draft            String?   @db.Text
  errorMessage     String?   @db.Text
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  blogPostSource BlogPostSource @relation(fields: [blogPostSourceId], references: [id], onDelete: Cascade)

  @@index([blogPostSourceId])
  @@index([status])
}

model CrewProjectVisibility {
  id              String   @id @default(uuid())
  crewSourceId    String
  projectSourceId String
  isVisible       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  crewSource    CrewSource    @relation(fields: [crewSourceId], references: [id], onDelete: Cascade)
  projectSource ProjectSource @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)

  @@unique([crewSourceId, projectSourceId])
  @@index([projectSourceId])
}

model CrewBlogVisibility {
  id               String   @id @default(uuid())
  crewSourceId     String
  blogPostSourceId String
  isVisible        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  crewSource     CrewSource     @relation(fields: [crewSourceId], references: [id], onDelete: Cascade)
  blogPostSource BlogPostSource @relation(fields: [blogPostSourceId], references: [id], onDelete: Cascade)

  @@unique([crewSourceId, blogPostSourceId])
  @@index([blogPostSourceId])
}

model ProjectFeaturedBlog {
  id               String   @id @default(uuid())
  projectSourceId  String
  blogPostSourceId String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectSource  ProjectSource  @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
  blogPostSource BlogPostSource @relation(fields: [blogPostSourceId], references: [id], onDelete: Cascade)

  @@unique([projectSourceId, blogPostSourceId])
  @@index([blogPostSourceId])
}

model ProjectPeriodOverride {
  id              String   @id @default(uuid())
  projectSourceId String
  label           String?
  startedAt       String
  endedAt         String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectSource ProjectSource @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)

  @@index([projectSourceId])
}

model ProjectParticipantOverride {
  id              String   @id @default(uuid())
  projectSourceId String
  crewSourceId    String
  isVisible       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectSource ProjectSource @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
  crewSource    CrewSource    @relation(fields: [crewSourceId], references: [id], onDelete: Cascade)

  @@unique([projectSourceId, crewSourceId])
  @@index([crewSourceId])
}

model CloudBriefMetric {
  key       String   @id
  value     Int      @default(0)
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CloudUseProject {
  id                   String   @id @default(uuid())
  teamName             String
  description          String?  @db.Text
  durationFromYear     Int?
  durationFromSemester Int?
  durationToYear       Int?
  durationToSemester   Int?
  projectImageUrl      String?
  isVisible            Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CloudFaqCategory {
  code             String   @id
  categoryTitle    String
  categoryImageUrl String?
  isVisible        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  faqs CloudFaq[]
}

model CloudFaq {
  id           String   @id @default(uuid())
  publicId     Int      @unique @default(autoincrement())
  categoryCode String
  faqTitle     String
  faqAnswer    String   @db.Text
  isVisible    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category CloudFaqCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)

  @@index([categoryCode])
}

model CloudNotice {
  id          String   @id @default(uuid())
  publicId    Int      @unique @default(autoincrement())
  noticeType  String
  noticeTitle String
  content     String   @db.Text
  authorId    Int?
  authorName  String?
  readCount   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments CloudNoticeAttachment[]
}

model CloudNoticeAttachment {
  id            String   @id @default(uuid())
  publicId      Int      @unique @default(autoincrement())
  cloudNoticeId String
  fileUrl       String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notice CloudNotice @relation(fields: [cloudNoticeId], references: [id], onDelete: Cascade)

  @@index([cloudNoticeId])
}

model CloudProductCategory {
  code             String   @id
  categoryTitle    String
  categoryImageUrl String?
  isVisible        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products CloudProduct[]
}

model CloudProduct {
  id              String   @id @default(uuid())
  publicId        Int      @unique @default(autoincrement())
  categoryCode    String
  projectSourceId String?
  productIconUrl  String?
  productName     String
  description     String   @db.Text
  cloudLink       String?
  content         String   @db.Text
  isVisible       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        CloudProductCategory         @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  projectSource   ProjectSource?               @relation(fields: [projectSourceId], references: [id], onDelete: SetNull)
  participants    CloudProductParticipant[]
  relatedServices CloudProductRelatedService[]

  @@index([categoryCode])
  @@index([projectSourceId])
}

model CloudProductParticipant {
  id             String   @id @default(uuid())
  cloudProductId String
  crewSourceId   String?
  crewPublicId   Int?
  profileUrl     String?
  crewName       String
  univDepartment String?
  univJoinedYear String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product CloudProduct @relation(fields: [cloudProductId], references: [id], onDelete: Cascade)

  @@index([cloudProductId])
}

model CloudProductRelatedService {
  id             String   @id @default(uuid())
  cloudProductId String
  pageTitle      String
  thumbnailUrl   String?
  serviceLink    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product CloudProduct @relation(fields: [cloudProductId], references: [id], onDelete: Cascade)

  @@index([cloudProductId])
}

model SyncJob {
  id            String    @id @default(uuid())
  source        String
  status        String
  requestedBy   String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  totalCount    Int       @default(0)
  createdCount  Int       @default(0)
  updatedCount  Int       @default(0)
  archivedCount Int       @default(0)
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs SyncLog[]

  @@index([source, status])
  @@index([startedAt])
}

model SyncLog {
  id        String   @id @default(uuid())
  syncJobId String
  level     String
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
}

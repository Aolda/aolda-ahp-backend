{
  "name": "aolda-ahp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Aolda AHP backend (TypeScript/Fastify)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "team:profile-image:sync": "tsx src/scripts/run-crew-profile-image-sync.ts",
    "admin:content:sync": "tsx src/scripts/run-notion-content-sync.ts",
    "admin:auth:smoke": "tsx src/scripts/run-admin-auth-smoke.ts",
    "crew:academic:test": "tsx --test src/scripts/crew-academic-profile.test.ts",
    "crew:images:test": "tsx --test src/scripts/crew-image-refresh.test.ts",
    "crew:images:integration": "tsx src/scripts/run-crew-image-integration.ts",
    "crew:academic:integration": "tsx src/scripts/run-crew-academic-profile-integration.ts",
    "http:smoke": "tsx src/scripts/run-http-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@notionhq/client": "^5.16.0",
    "@prisma/client": "^6.4.1",
    "prisma": "^6.4.1",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "prisma": "^6.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
